{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "seeddance2",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Keep dashboard-managed variables instead of letting wrangler delete them on deploy.
  "keep_vars": true,
  "vars": {
    "DATA_BACKEND": "cloudflare",
    "AUTH_TRUST_HOST": "true",
    "KIE_API_URL": "https://api.kie.ai/api/v1",
    "R2_BUCKET_NAME": "seedance2-media",
    "R2_PUBLIC_BASE_URL": "https://media.seedance2video.cc",
    "NEXT_PUBLIC_SITE_URL": "https://www.seedance2video.cc",
    "NEXT_PUBLIC_APP_URL": "https://www.seedance2video.cc",
    "NEXT_PUBLIC_MEDIA_BASE_URL": "https://media.seedance2video.cc",
    "NEXT_PUBLIC_VIDEO_CDN_URL": "https://media.seedance2video.cc",
    "CREEM_API_URL": "https://api.creem.io",
    "CREEM_SUCCESS_URL": "https://www.seedance2video.cc/zh/dashboard"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "seeddance2"
    }
  ],
  // Phase 1 Cloudflare data bindings for the Supabase -> Auth.js + D1 + R2 + KV migration.
  // Replace the placeholder ids/names with your real resources before enabling the new runtime paths.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seedance2-prod"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "seedance2-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV"
    }
  ],
  "observability": {
    "enabled": true
  }
}
